# Supabase 프로젝트 공개 URL
NEXT_PUBLIC_SUPABASE_URL=

# 브라우저용 publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 기존 프로젝트 호환용 브라우저 anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 Supabase secret key
SUPABASE_SECRET_KEY=

# 기존 프로젝트 호환용 서버 전용 service_role key
SUPABASE_SERVICE_ROLE_KEY=

# bcrypt로 해시한 관리자 공용 비밀번호
ADMIN_PASSWORD_HASH=

# 관리자 세션 서명용 32바이트 이상 난수
ADMIN_SESSION_SECRET=

# 개인정보 AES-256-GCM 암호화용 Base64 32바이트 키
PII_ENCRYPTION_KEY=

# 연락처 HMAC 해시용 32바이트 이상 난수
PHONE_HASH_SECRET=

# 참석자 접근 토큰 HMAC 해시용 32바이트 이상 난수
PARTICIPANT_TOKEN_HASH_SECRET=

# 로그인 속도 제한 식별자 해시용 32바이트 이상 난수
LOGIN_RATE_HASH_SECRET=

# Vercel Cron 요청 인증용 32바이트 이상 난수
CRON_SECRET=

# Preview 리허설 초기화 명시 허용(true일 때만)
ALLOW_REHEARSAL_RESET=

# 실제 연결된 Preview Supabase project ref
SUPABASE_PROJECT_ID=

# 초기화를 허용한 Preview Supabase project ref
REHEARSAL_ALLOWED_SUPABASE_PROJECT_ID=